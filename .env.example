NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://briefbot:briefbot@localhost:5432/briefbot
TELEGRAM_BOT_TOKEN=
TELEGRAM_MODE=polling
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=
DESIGNER_TELEGRAM_CHAT_ID=
OPENCODE_BASE_URL=http://127.0.0.1:4096
OPENCODE_SERVER_USERNAME=opencode
OPENCODE_SERVER_PASSWORD=
OPENCODE_TIMEOUT_MS=60000
EXTRACTION_MODELS=alibaba/qwen3.8-flash,alibaba/qwen3.7-plus
DASHSCOPE_COMPATIBLE_BASE_URL=https://YOUR_WORKSPACE_ID.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
DASHSCOPE_API_KEY=
STT_BASE_URL=https://YOUR_WORKSPACE_ID.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
STT_API_KEY=
STT_MODELS=qwen3-asr-flash,qwen-audio-3.0-asr-flash
STT_TIMEOUT_MS=90000
AUDIO_STORAGE_DIR=./data/audio
AUDIO_RETENTION_DAYS=30
MAX_VOICE_DURATION_SECONDS=300
MAX_TEXT_LENGTH=12000
MAX_VOICE_BYTES=7500000
LOG_LEVEL=info
