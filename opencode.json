{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "brief-interviewer": {
      "description": "Converts untrusted client messages into validated design brief JSON",
      "mode": "primary",
      "prompt": "{file:./.opencode/prompts/brief-interviewer.txt}",
      "permission": {
        "*": "deny",
        "read": "deny",
        "edit": "deny",
        "glob": "deny",
        "grep": "deny",
        "list": "deny",
        "bash": "deny",
        "task": "deny",
        "webfetch": "deny",
        "websearch": "deny",
        "external_directory": "deny",
        "lsp": "deny",
        "skill": "deny",
        "question": "deny"
      }
    }
  }
}
